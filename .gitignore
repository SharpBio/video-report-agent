# 本地依赖与缓存（仓库不分发）
.venv/
node_modules/
__pycache__/
.pytest_cache/
.ruff_cache/

# 本地密钥与运行状态（含凭据，严禁入库）
.env
.env.*
!.env.example
config/
runs/
artifacts/

# 打包产物与本地媒体样本
*.zip
*.mp4
*.m4v
*.mov
*.wav
models/

# 一次性调试脚本（历史文件名：.exp.mjs / .rev.mjs / .dbg.mjs / .idcheck.mjs）
.exp.mjs
.rev.mjs
.dbg.mjs
.idcheck.mjs

# OS / editor junk
.DS_Store
Thumbs.db
desktop.ini
*.log
:memory:.ses

# 本地工具工作区（agent 记忆与临时文件）
.workbuddy/
